{
  "name": "webmcp-adventure-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b && npm --prefix packages/app run build",
    "dev": "npm --prefix packages/app run dev",
    "preview": "npm --prefix packages/app run preview"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
